    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:baa": "tsx src/scripts/genBaaTemplate.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
