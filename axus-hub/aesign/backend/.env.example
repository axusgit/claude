# Axus eSign backend config
PORT=8000
DATABASE_URL=postgresql://axus:axus@postgres/aesign
PLATFORM_DOMAIN=hub.axustechnologies.com
PUBLIC_BASE_URL=https://aesign.axustechnologies.com
STORAGE_DIR=/data/aesign
GOTENBERG_URL=http://gotenberg:3000

# Email (M365 relay) — sender changes later, kept configurable
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=support@axustechnologies.com
SMTP_PASS=
MAIL_FROM=Axus <support@axustechnologies.com>

# Dev only: identity fallback when NOT behind the Authentik forward-auth proxy
# DEV_USER_EMAIL=dev@axustechnologies.com
# DEV_USER_NAME=Dev User
# DEV_USER_GROUPS=app-aesign|aesign-role-admin
