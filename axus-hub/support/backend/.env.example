# Copy to .env and fill in real values (never commit .env).
DATABASE_URL=postgresql://USER:PASSWORD@localhost/support
SECRET_KEY=generate-a-random-64-char-string   # only used in local/JWT auth mode

# Auth mode: "local" = standalone bcrypt+JWT login; "central" = trust Authentik
# forward-auth headers (set to central in production behind the platform proxy).
AUTH_MODE=local
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server binding (see run.py).
HOST=0.0.0.0
PORT=8000

# Email-to-ticket via Microsoft Graph (app-only / client credentials).
# Leave blank to disable. From the Entra app registration:
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SUPPORT_MAILBOX=support@axustechnologies.com
EMAIL_POLL_SECONDS=60

# Local dev without PostgreSQL:
# DATABASE_URL=sqlite:///./support.db

# Local dev convenience for central mode (synthesizes an identity):
# DEV_USER_EMAIL=you@axustechnologies.com
# DEV_USER_NAME=Your Name
# DEV_USER_GROUPS=role-admin|app-support|app-hub
# DEV_USER_CLIENT_ID=
