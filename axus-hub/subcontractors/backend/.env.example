# Axus Subcontractor Management — backend env template.
# Production values live only in infra/.env on the server (gitignored); this file
# documents the variables the service reads.

# --- Database ---
# Production: the shared Postgres instance's own `subcontractor` database.
#   DATABASE_URL=postgresql://axus:CHANGE_ME@postgres/subcontractor
# Local dev: leave unset to use the bundled SQLite file (subcontractor_dev.db).

# --- Auth (shared platform identity) ---
# central = trust Authentik forward-auth headers (production, behind Traefik)
# local   = synthesize a dev admin identity (default; standalone local dev)
AUTH_MODE=local
# Dev-only identity simulation (AUTH_MODE=local):
# DEV_USER_EMAIL=dev@axustechnologies.com
# DEV_USER_NAME=Dev Admin
# DEV_USER_GROUPS=role-admin|app-subcontractors

# --- Outbound email (shared O365 relay; mapped from AUTHENTIK_EMAIL__* in compose) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# --- File storage ---
# Production mounts the `subcontractor_data` volume here.
UPLOAD_DIR=uploads
MAX_ATTACHMENT_MB=25
# Allowed upload types mirror the ASD attachment allowlist (see app/storage.py).
# ALL uploaded documents (W-9 + COI) are encrypted at rest with this Fernet key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DOC_ENCRYPTION_KEY=CHANGE_ME

# --- Public onboarding portal ---
# Base URL of the public onboarding portal (used to build secure links).
# PORTAL_URL=https://sub.hub.axustechnologies.com/onboarding
ONBOARDING_TOKEN_TTL_DAYS=30

# --- aesign integration (agreement e-signature; DECISION #2 pending) ---
# AESIGN_INTERNAL_URL=http://aesign:8080
# AESIGN_EXTERNAL_API_TOKEN=CHANGE_ME

# --- Compliance email guardrail (soft-launch; keep set until go-live) ---
# Comma-separated allowlist of addresses that may receive vendor-facing mail while
# testing, so reminders never reach real subcontractors before launch.
# NOTIFY_ALLOW=acarr@axustechnologies.com
NOTIFY_ENABLED=0
