# ---------------------------------------------------------------------------
# Bahia Honda cabin watcher config. Copy to `.env` and fill in.
# Only the channels you fill in will fire. ntfy needs no account.
# NOTE: keep comments on their own lines, never after a value.
# ---------------------------------------------------------------------------

# --- What to watch (defaults target the 6 Bahia Honda cabins) ---------------
PLACE_ID=4
FACILITY_ID=12
PARK_NAME=Bahia Honda
FACILITY_NAME=Cabins
# 2-night minimum is enforced by the park
MIN_NIGHTS=2
# scan this many months out from today
MONTHS_AHEAD=6
# earliest check-in = today + this many days
START_OFFSET_DAYS=0

# Optional: restrict to a specific stay window (ISO dates, e.g. 2026-12-24).
# Leave blank to alert on ANY opening in the scan window.
WATCH_START=
WATCH_END=
# true = only alert on stays that include a Fri or Sat night
WEEKENDS_ONLY=false

# true = don't log the "nothing available" line (cleaner cron logs)
QUIET=true

# --- Channel 1: ntfy push (recommended, zero setup) -------------------------
# 1. Install the "ntfy" app on your phone (iOS/Android).
# 2. Subscribe to your private topic (the value below).
# 3. Done. Leave NTFY_TOKEN blank unless using an authenticated ntfy server.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Channel 2: Email (via SMTP) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=acarr@axustechnologies.com

# --- Channel 3: Text via carrier email-to-SMS gateway (no Twilio/A2P) --------
# Gets a real text on your phone using the SMTP settings above. Set this to your
# carrier gateway address for your number, e.g.:
#   T-Mobile: <10digits>@tmomail.net
#   AT&T:     <10digits>@txt.att.net
#   Verizon:  <10digits>@vtext.com   (being deprecated by Verizon)
#   Google Fi:<10digits>@msg.fi.google.com
EMAIL_SMS_TO=

# --- Channel 4: SMS (via Twilio) --------------------------------------------
# NOTE: US SMS needs A2P 10DLC (local #) or toll-free verification, or the
# recipient must be a verified number on a trial account. Otherwise carriers
# filter it (err 30034) and it won't arrive. Leave blank until approved.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_TO=
