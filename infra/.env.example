# Copy to infra/.env on the server and fill in real values. NEVER commit infra/.env.
# Generate secrets with:  openssl rand -base64 48

# --- Platform ---
PLATFORM_DOMAIN=hub.axustechnologies.com
ACME_EMAIL=acarr@axustechnologies.com

# --- PostgreSQL (shared by Authentik + Support) ---
POSTGRES_USER=axus
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Authentik (identity provider) ---
AUTHENTIK_TAG=2024.10.5            # set to a current stable goauthentik/server tag
AUTHENTIK_SECRET_KEY=CHANGE_ME_random_50_chars
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_initial_admin_password
AUTHENTIK_BOOTSTRAP_EMAIL=acarr@axustechnologies.com

# --- Support app ---
SUPPORT_SECRET_KEY=CHANGE_ME_unused_in_central_mode_but_set_anyway

# --- Email (SMTP relay for invites / recovery / MFA) ---
AUTHENTIK_EMAIL__HOST=smtp.office365.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=support@axustechnologies.com
AUTHENTIK_EMAIL__PASSWORD=CHANGE_ME_smtp_password
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=Axus <support@axustechnologies.com>
