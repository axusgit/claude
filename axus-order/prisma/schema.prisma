// Axus Order — Prisma schema (SQLite for the MVP).
// Catalog/Quote models below come from the provided quote-schema.prisma.
// Identity/login is delegated to Authentik (see lib/auth.ts) — no local User table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CatalogItem {
  id           String      @id @default(cuid())
  internalName String
  description  String?
  category     String?
  mfgPN        String?
  synnexSKU    String?
  // Admin-defined successor part (e.g. FAP-231F-A -> FAP-231K-A). A TD SYNNEX SKU
  // (numeric) or a manufacturer part number; offered to the customer as an
  // accept-able replacement when set. replacementName is an optional friendly label.
  replacementSku   String?
  replacementName  String?
  marginType   String      @default("PERCENT") // "PERCENT" | "FIXED"
  marginValue  Float       @default(15)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  // Client-facing ballpark prices, refreshed by the nightly price job (1 AM ET).
  // The catalog reads these instead of calling the distributor on every request.
  cachedUnitPrice        Float?
  cachedReplacementPrice Float?
  pricedAt               DateTime?
  quoteLines   QuoteLine[]
}

model Quote {
  id         String      @id @default(cuid())
  // organizationId String?   // enable when multi-tenant
  status     String      @default("DRAFT")
  subtotal   Float
  currency   String      @default("USD")
  validUntil DateTime
  createdAt  DateTime    @default(now())
  // Human-friendly quote number: <3-letter business><MMDDYYYY><NNN> (e.g. AXU09032026001).
  quoteNumber          String?   @unique
  // Customer identity — self-supplied at creation (the site is open, no login).
  customerName         String?
  customerEmail        String?
  customerCompany      String?
  // Client IP captured for the usage/audit log.
  ipAddress            String?
  // Disclaimer acceptance (required before a quote is created).
  disclaimerAcceptedAt DateTime?
  // Email delivery tracking ("Talk to Axus" send + resend/auto-retry).
  // emailStatus: null = never sent · "sent" · "failed".
  emailStatus   String?
  emailedAt     DateTime?
  emailError    String?
  emailAttempts Int       @default(0)
  lines      QuoteLine[]
}

// Anonymous page-visit log for the open site (usage/audit dashboard).
model Visit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String
  ip        String?
  userAgent String?
  referer   String?

  @@index([createdAt])
}

model QuoteLine {
  id               String       @id @default(cuid())
  quoteId          String
  quote            Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItemId    String?
  catalogItem      CatalogItem? @relation(fields: [catalogItemId], references: [id])
  description      String
  synnexSKU        String?
  qty              Int
  unitBallpark     Float?
  lineTotal        Float?
  unitCostSnapshot Float?       // SERVER ONLY — never return in an API response
  status           String
  // When the customer accepted a suggested alternative, record it for a quote note.
  usedReplacement  Boolean      @default(false)
  originalName     String?      // the original item this replacement stands in for
}
