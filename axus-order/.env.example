# --- Axus Order env template — copy to .env and fill in ---

# SQLite database (Prisma)
DATABASE_URL="file:./dev.db"

# Adapter: "mock" (no keys needed) or "real" (needs TD SYNNEX keys below)
SYNNEX_ADAPTER=mock

# Auth: "local" synthesizes a dev identity for standalone runs;
# "central" trusts the Authentik forward-auth headers (production).
AUTH_MODE=local
APP_GROUP=app-order
DEV_USER_EMAIL=dev@axustechnologies.com
DEV_USER_NAME=Dev User
DEV_USER_GROUPS=role-admin|app-hub|app-order

# --- TD SYNNEX (only when SYNNEX_ADAPTER=real) ---
SYNNEX_CLIENT_ID=
SYNNEX_CLIENT_SECRET=
SYNNEX_API_BASE=https://api-uat.us.tdsynnex.com
SYNNEX_TOKEN_URL=https://sso.us.tdsynnex.com/oauth2/v1/token
SYNNEX_PA_VERSION=2.8
SYNNEX_PRICE_TYPE=REGULAR
