# Axus Syslog configuration. Copy to .env on the box and edit.
# The .env file is never committed.

# --- Web admin login (required) ---
ADMIN_USER=admin
# Set a strong password. Sign-in is required to view any logs.
ADMIN_PASSWORD=change-me-now
# Random secret for signing the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Web server ---
# Port the Express dashboard listens on (behind nginx). Loopback only.
PORT=3260
# Public base URL (used only for display).
BASE_URL=https://syslog.axustechnologies.com

# --- Syslog ingest ---
# UDP port to receive syslog on. 514 is the standard. Binding <1024 needs
# CAP_NET_BIND_SERVICE (the systemd unit grants it).
SYSLOG_UDP_PORT=514
# Bind address for the collector. 0.0.0.0 = all interfaces.
SYSLOG_BIND=0.0.0.0

# --- Retention ---
# Logs auto-clear after this many days (fixed; no UI control). Sweep runs every
# minute and removes anything older. Default 7.
RETENTION_DAYS=7
# Hard cap on stored rows (0 = no cap). Oldest are trimmed past this.
MAX_ROWS=5000000

# --- Single sign-on (Authentik / Axus Hub, OpenID Connect) ---
# When enabled, users sign in through the Hub (no local password). The local
# ADMIN_USER/ADMIN_PASSWORD login stays as an emergency break-glass at /login.
OIDC_ENABLED=0
# Authentik OAuth2 base (global authorize/token/userinfo live here):
OIDC_BASE=https://id.hub.axustechnologies.com/application/o
# This app's Authentik application slug (used for the end-session endpoint):
OIDC_SLUG=axus-syslog
OIDC_CLIENT_ID=axus-syslog
OIDC_CLIENT_SECRET=change-me-match-authentik-provider
# Redirect URI is derived as BASE_URL + /auth/callback — register it in Authentik.

# --- Keyword alerts (ntfy push on matching incoming logs) ---
# Set a topic to enable. Subscribe to it in the ntfy app to receive pushes.
ALERT_NTFY_TOPIC=
# Comma-separated, case-insensitive substrings to alert on.
ALERT_KEYWORDS=No Service
# Min seconds between alerts for the same host+keyword (anti-flood).
ALERT_COOLDOWN_SEC=300
# Optional ntfy access token. Anonymous ntfy.sh has a small PER-IP daily quota
# (easily exhausted by chatty senders); an account token raises it a lot.
# Create at ntfy.sh (account -> access tokens) or self-host ntfy.
ALERT_NTFY_TOKEN=
# Dead-man's switch: alert (to ALERT_NTFY_TOPIC) if NO syslog is received for this
# many seconds — catches the phones going down / "No Service" / network loss. A
# recovery alert fires when messages resume. 0 disables. Default 120 (2 min).
SILENCE_ALERT_SEC=120

# --- Email alerts (SMTP; optional second channel alongside ntfy) ---
# When set, per-device offline/online alerts and the silence watchdog also send
# email. Leave blank to stay ntfy-only. For Microsoft 365 use smtp.office365.com:587
# with a mailbox that has SMTP AUTH enabled and an app password (needed with MFA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address (defaults to SMTP_USER). Must be a valid sender for the mailbox.
SMTP_FROM=
# Comma-separated recipients for alert emails.
ALERT_EMAIL_TO=

# --- Branding (optional; defaults match the standard Axus look) ---
BRAND_NAME=Axus Syslog
ACCENT_COLOR=#f97316
ACCENT_HOVER=#ea580c
TZ=America/New_York
