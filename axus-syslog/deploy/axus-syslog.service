[Unit]
Description=Axus Syslog (UDP collector + web dashboard — Node)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/axus-syslog
EnvironmentFile=/opt/axus-syslog/.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=TZ=America/New_York
ExecStart=/usr/bin/node /opt/axus-syslog/server.js
Restart=on-failure
RestartSec=3

# Bind the privileged UDP 514 port while still running as the ubuntu user.
# (No CapabilityBoundingSet= — restricting it to CAP_NET_BIND_SERVICE would strip
# CAP_SETUID/CAP_SETGID and stop `sudo ufw` in the Firewall panel from escalating.)
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening. ProtectSystem=full leaves /opt writable so the SQLite DB under
# /opt/axus-syslog/data works. Do NOT switch to strict without ReadWritePaths.
# NOTE: NoNewPrivileges must stay OFF — the Firewall panel shells out to
# `sudo ufw` (scoped via /etc/sudoers.d/axus-syslog), and NoNewPrivileges would
# block that privilege escalation.
ProtectSystem=full
PrivateTmp=true
# ProtectSystem=full makes /etc read-only; ufw needs to write its rule files
# when the Firewall panel adds/removes a source.
ReadWritePaths=/etc/ufw

[Install]
WantedBy=multi-user.target
