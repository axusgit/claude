# Copy to .env and fill in. Never commit .env.

# Admin login (what YOU use to manage links + files)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Session signing secret — set to a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the app listens on (nginx proxies to this)
PORT=3210

# Max size per uploaded file, in MB. 0 or unset = unlimited (no per-file cap).
# Only set this if you deliberately want to cap upload size.
MAX_UPLOAD_MB=0

# Set to 'production' so the session cookie is marked Secure (HTTPS only)
NODE_ENV=production

# Optional: force the public link base URL (else derived from the request).
# Set this to your real https URL so copied links are always correct.
# BASE_URL=https://upload.axustechnologies.com

# Optional branding
BRAND_NAME=Axus File Share
ACCENT_COLOR=#f97316
ACCENT_HOVER=#ea580c

# Where uploads + db.json live (default ./data)
# DATA_DIR=/var/lib/axus-fileshare

# ---------------------------------------------------------------------------
# NOC email notifications (optional). When SMTP is configured, the app emails
# NOTIFY_EMAIL_TO when a share link is created and/or a file is uploaded.
# Uses M365 SMTP (auth as the mailbox, send AS no-reply@ via Send-As).
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=support@axustechnologies.com
# SMTP_PASS=
# SMTP_FROM=Axus File Share <no-reply@axustechnologies.com>
# NOTIFY_EMAIL_TO=noc@axustechnologies.com
# Turn either event off by setting its var to 0 (both default on when SMTP is set)
# NOTIFY_ON_LINK_CREATED=1
# NOTIFY_ON_UPLOAD=1
