[Unit]
Description=Axus File Share (secure upload portal — Node/Express)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/axus-fileshare
EnvironmentFile=/opt/axus-fileshare/.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=TZ=America/New_York
ExecStart=/usr/bin/node /opt/axus-fileshare/server.js
Restart=on-failure
RestartSec=3
# Hardening. NOTE: ProtectSystem=full leaves /opt writable, so uploads to
# /opt/axus-fileshare/data work. Do NOT switch to ProtectSystem=strict without
# a ReadWritePaths= for the data dir.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
